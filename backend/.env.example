ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=true
# For Supabase, download its CA certificate from Database Settings and set this path.
DATABASE_SSL_CA_FILE=
DATABASE_POOL_SIZE=5
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Needed only when accepting legacy HS256 access tokens (verified through /auth/v1/user).
SUPABASE_PUBLISHABLE_KEY=
AUTH_AUDIENCE=authenticated
CORS_ORIGINS=["http://localhost:3000"]
# Cloudflare Turnstile: takes priority over the external verification service below.
TURNSTILE_SECRET_KEY=
# Optional exact hostname check; use localhost for local development or your deployed domain.
TURNSTILE_EXPECTED_HOSTNAME=
SECURITY_VERIFICATION_URL=
SECURITY_VERIFICATION_SECRET=
# Explicit local-only bypass; production rejects this configuration.
SECURITY_ALLOW_DEVELOPMENT=false
WORKER_INTERVAL_SECONDS=5
REDIS_URL=redis://127.0.0.1:6379/0
ABUSE_PROTECTION_ENABLED=true
# Generate a random secret of at least 32 characters; shared by all API workers.
ABUSE_KEY_SECRET=
REGISTRATION_RATE=0.05
REGISTRATION_BURST=3
POLLING_RATE=0.5
POLLING_BURST=5
ABUSE_VIOLATION_THRESHOLD=30
ABUSE_COOLDOWN_SECONDS=60
DEVICE_ACCOUNT_CAP=6
DEVICE_NETWORK_ACCOUNT_CAP=2
ABUSE_IDENTITY_WINDOW_SECONDS=86400
