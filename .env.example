# mock = in-browser fake backend (default, zero setup). live = real backend at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_BASE_URL=

# Supabase (Google OAuth). Leave empty to use the local demo identity.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile. Defaults to Cloudflare's always-pass test keys when empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Server-only. Never prefix with NEXT_PUBLIC_. Used by /api/turnstile in mock mode; the backend holds its own copy for live.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Must match the backend's reservation window (ms).
NEXT_PUBLIC_RESERVATION_WINDOW_MS=120000
